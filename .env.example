# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
# Database: Render PostgreSQL internal/external URL or local postgres URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatapp?schema=public
JWT_SECRET=your_jwt_super_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
SESSION_SECRET=your_express_session_secret_key

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ==========================================
# Payments (Razorpay Sandbox / Test Mode)
# ==========================================
# Options: "razorpay" (uses keys below) or "mock" (offline dev / test sandbox)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Transaction Limits (in minor units / paise, e.g. 100 paise = 1 INR)
MIN_PAYMENT_AMOUNT=100
MAX_PAYMENT_AMOUNT=10000000

# ==========================================
# Storage Provider
# ==========================================
# Options: "local" (default, stores in server/uploads), "s3", "cloudinary"
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Google OAuth 2.0 (Optional)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==========================================
# SMTP Email Settings (Nodemailer OTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=noreply@chatapp.com

# ==========================================
# Mobile Client (Expo) Environment
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
