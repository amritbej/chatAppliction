# Backend API and WebSocket Origin
# For Render deployment, use your live backend Render URL:
EXPO_PUBLIC_API_URL=https://your-render-backend.onrender.com
EXPO_PUBLIC_SOCKET_URL=https://your-render-backend.onrender.com

# For Local development on physical phone over Wi-Fi, use your PC's LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:5000
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.X:5000

# For Local development on Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:5000
